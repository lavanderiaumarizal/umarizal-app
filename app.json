{
  "expo": {
    "name": "Umarizal",
    "slug": "umarizal-app",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#111827",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.umarizal.app",
      "versionCode": 5,
      "adaptiveIcon": {
        "backgroundColor": "#111827",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "O Umarizal usa a câmera para fotografar os tapetes na coleta e na entrega."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Umarizal usa sua localização para navegar na rota do dia e informar aos clientes o horário previsto de chegada.",
          "locationAlwaysAndWhenInUsePermission": "Permitir o tempo todo permite que o app envie sua posição da rota mesmo em segundo plano, mantendo o cliente informado em tempo real.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "@maplibre/maplibre-react-native",
      "./plugins/withAndroidReleaseAbiFilters"
    ],
    "extra": {
      "eas": {
        "projectId": "f635674a-9bbe-47f5-bf93-975664e953ab"
      }
    },
    "owner": "lavanderiaumarizal"
  }
}
